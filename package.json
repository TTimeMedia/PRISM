{
  "name": "prism",
  "private": true,
  "version": "0.1.0",
  "description": "PRISM — Your journey. Your way.",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @prism/mobile start",
    "db:start": "npx supabase start && npx supabase migration up",
    "db:up": "npx supabase migration up",
    "db:stop": "npx supabase stop",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "zod": "^3.24.1",
      "shell-quote": "^1.11.0",
      "compression": "^1.8.2",
      "source-map-js": "^1.2.2",
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=4 <6": "^5.0.12"
    }
  }
}
