# Copy to .env and fill in — see docs/SECURITY.md §14-15.
# Expo only exposes vars prefixed EXPO_PUBLIC_ to client code. These are
# the anon/public Supabase key — safe to ship because every table it can
# touch is protected by Row Level Security (see supabase/migrations).
# NEVER put a Supabase service-role key in this app.

# Local Supabase (after `supabase start`): http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL=
# Local Supabase: the "anon key" printed by `supabase start`
EXPO_PUBLIC_SUPABASE_ANON_KEY=
