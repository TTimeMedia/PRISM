{
  "expo": {
    "name": "Prism",
    "slug": "prism",
    "owner": "ttimemedia",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prism",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B0F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ttimemedia.prism",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsWriteOnlyAccessUsageDescription": "Prism adds the appointments you choose to sync to your calendar.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Calendar event",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.calendar-event",
              "com.apple.ical.ics"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "ttimemedia.prism",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "mimeType": "text/calendar"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Prism uses Face ID to unlock the app you locked for your privacy."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Prism uses your photo library to set your profile photo and to add photos to your milestones."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Prism reads your calendar only when you tap Import, so you can choose which appointments to add. It also adds appointments you choose to sync."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/047c1d78-6ba0-4f66-87bf-a965f9d08753"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "047c1d78-6ba0-4f66-87bf-a965f9d08753"
      }
    }
  }
}
