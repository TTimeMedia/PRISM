{
  "expo": {
    "name": "PRISM",
    "slug": "prism",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prism",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B0F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.prism.mobile"
    },
    "android": {
      "package": "app.prism.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "PRISM uses Face ID to unlock the app you locked for your privacy."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PRISM uses your photo library to set your profile photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
