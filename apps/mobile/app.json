{
  "expo": {
    "name": "Prism",
    "slug": "prism",
    "owner": "ttimemedia",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prism",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B0F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ttimemedia.prism",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsWriteOnlyAccessUsageDescription": "Prism adds the appointments you choose to sync to your calendar.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Calendar event",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["public.calendar-event", "com.apple.ical.ics"]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "appleTeamId": "ZP2P9TDS45"
    },
    "android": {
      "package": "ttimemedia.prism",
      "adaptiveIcon": {
        "backgroundColor": "#16263F",
        "foregroundImage": "./assets/images/app-icons/android-slate.png",
        "monochromeImage": "./assets/images/app-icons/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.USE_FINGERPRINT"],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "mimeType": "text/calendar"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F8F8FA",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0B0B0F"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Prism uses Face ID to unlock the app you locked for your privacy."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Prism uses your photo library to set your profile photo and to add photos to your milestones and journal entries.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Prism reads your calendar when you import, or to suggest appointments if you turn that on, so you can choose which to add. Only the ones you choose are saved. It also adds appointments you choose to sync.",
          "remindersPermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-sensors",
        {
          "motionPermission": false
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Mist",
            "ios": "./assets/images/app-icons/icon-mist.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/android-mist.png",
              "backgroundColor": "#2B3138"
            }
          },
          {
            "name": "Prism",
            "ios": "./assets/images/app-icons/icon-prism.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/android-prism.png",
              "backgroundColor": "#231B3A"
            }
          },
          {
            "name": "Ocean",
            "ios": "./assets/images/app-icons/icon-ocean.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/android-ocean.png",
              "backgroundColor": "#0B2A35"
            }
          },
          {
            "name": "Forest",
            "ios": "./assets/images/app-icons/icon-forest.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/android-forest.png",
              "backgroundColor": "#17281C"
            }
          },
          {
            "name": "Ember",
            "ios": "./assets/images/app-icons/icon-ember.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/android-ember.png",
              "backgroundColor": "#3A1A12"
            }
          },
          {
            "name": "Dusk",
            "ios": "./assets/images/app-icons/icon-dusk.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/android-dusk.png",
              "backgroundColor": "#2B1D3F"
            }
          },
          {
            "name": "Blossom",
            "ios": "./assets/images/app-icons/icon-blossom.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/android-blossom.png",
              "backgroundColor": "#FFF0EC"
            }
          }
        ]
      ],
      "@bacons/apple-targets",
      "./plugins/withWatchVersion"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/047c1d78-6ba0-4f66-87bf-a965f9d08753"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "047c1d78-6ba0-4f66-87bf-a965f9d08753"
      }
    }
  }
}
